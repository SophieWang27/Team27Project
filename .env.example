# 0 uses the laptop's default webcam. Replace with the ESP32-CAM URL later.
CAMERA_SOURCE=0

# Downloaded by: python scripts/download_model.py --variant lite
MODEL_PATH=models/pose_landmarker_lite.task

# Leave empty until the Arduino R4 is connected. Example macOS: /dev/cu.usbmodemXXXX
# Example Raspberry Pi: /dev/ttyACM0
SERIAL_PORT=
BAUD_RATE=115200

# Pose calibration settings. Squat thresholds load from data/research_rules.json.
# Uncomment a threshold below only when deliberately overriding the research notes.
MIN_VISIBILITY=0.45
CALIBRATION_FRAMES=30
# MIN_SQUAT_DEPTH=0.291
# MAX_HIP_DRIFT=0.005
# MAX_HEAD_DRIFT=0.00169
